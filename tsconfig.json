{
  // Acesse https://aka.ms/tsconfig para ler mais sobre este arquivo
  "compilerOptions": {
    // Estrutura de arquivos
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Configurações de ambiente (Node.js + TypeScript 5.x)
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM"],

    // Outras saídas
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noEmitOnError": true,

    // Opções de verificação estrita
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Opções de estilo (descomente conforme desejar mais rigor)
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,

    // Opções recomendadas
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
